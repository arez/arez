load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_java//java:defs.bzl", "java_import")
load("//third_party/java:rules.bzl", "java_library")

java_library(
    name = "core",
    visibility = [
        "//:__pkg__",
        "//core/src/test/java/arez:__pkg__",
        "//extras/dom:__pkg__",
        "//extras/promise:__pkg__",
        "//extras/spytools:__pkg__",
        "//extras/testng:__pkg__",
        "//integration-tests:__pkg__",
        "//persist/core:__pkg__",
        "//persist/integration-tests:__pkg__",
        "//persist/processor/src/test/java/arez/persist/processor:__pkg__",
        "//processor/src/test/java/arez/processor:__pkg__",
    ],
    exports = ["//core/src/main/java/arez"],
)

test_suite(
    name = "tests",
    tests = ["//core/src/test/java/arez:tests"],
    visibility = ["//:__pkg__"],
)

java_import(
    name = "packaged",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    visibility = ["//:__pkg__"],
    exports = ["//third_party/java:braincheck_core"],
    deps = [
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
        "//third_party/java:org_jetbrains_annotations",
    ],
)

j2cl_library(
    name = "packaged_j2cl",
    srcs = ["//tools/release:core_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:grim_annotations-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
    ],
)
