load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("//third_party/java:rules.bzl", "java_library")
load("//tools/release:release.bzl", "release_source_jar")

package(default_visibility = ["//persist/core:__subpackages__"])

filegroup(
    name = "all",
    srcs = [
        "ConvertersTest.java",
        "package-info.java",
    ],
)

java_library(
    name = "browser_test_java",
    testonly = True,
    srcs = [
        "WebStorageServiceBrowserTest.java",
        "package-info.java",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        "//persist/core",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
    ],
)

release_source_jar(
    name = "browser_test_sources",
    testonly = True,
    out = "browser-test-sources.jar",
    java_targets = [":browser_test_java"],
)

j2cl_library(
    name = "browser_test_j2cl",
    testonly = True,
    srcs = [":browser_test_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//persist/core/src/test/js:__pkg__"],
    deps = [
        "//:persist-core-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jspecify-j2cl",
    ],
)
