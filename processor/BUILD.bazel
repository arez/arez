load("@rules_java//java:defs.bzl", "java_import", _java_plugin = "java_plugin")
load("//third_party/java:rules.bzl", "java_library")

java_library(
    name = "processor",
    visibility = [
        "//:__pkg__",
        "//persist/processor/src/test/java/arez/persist/processor:__pkg__",
        "//processor/src/test/java/arez/processor:__pkg__",
    ],
    exports = ["//processor/src/main/java/arez/processor"],
)

alias(
    name = "plugin",
    actual = "//processor/src/main/java/arez/processor:plugin",
    visibility = [
        "//extras/dom:__pkg__",
        "//extras/promise:__pkg__",
        "//extras/spytools:__pkg__",
        "//integration-tests:__pkg__",
        "//persist/core:__pkg__",
        "//persist/integration-tests:__pkg__",
    ],
)

test_suite(
    name = "all_tests",
    tests = ["//processor/src/test/java/arez/processor:all_tests"],
    visibility = ["//:__pkg__"],
)

test_suite(
    name = "jspecify_contracts",
    tests = [
        "//processor/src/test/java/arez/processor:jspecify_diagnostics",
        "//processor/src/test/java/arez/processor:jspecify_goldens",
        "//processor/src/test/java/arez/processor:nullability",
    ],
    visibility = ["//visibility:private"],
)

java_import(
    name = "packaged",
    jars = ["//tools/release:processor_jar"],
    srcjar = "//tools/release:processor_sources",
    visibility = ["//:__pkg__"],
    deps = [],
)

_java_plugin(
    name = "packaged_plugin",
    generates_api = True,
    processor_class = "arez.processor.ArezProcessor",
    visibility = ["//:__pkg__"],
    deps = [":packaged"],
)
