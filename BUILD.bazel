load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_java//java:defs.bzl", "java_import", "java_plugin")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

test_suite(
    name = "jvm_tests",
    tests = [
        "//core:tests",
        "//extras/dom:tests",
        "//extras/spytools:tests",
        "//integration-tests:tests",
        "//persist/core:tests",
        "//persist/integration-tests:tests",
        "//persist/processor:all_tests",
        "//processor:all_tests",
    ],
)

test_suite(
    name = "browser_tests",
    tests = [
        "//extras/dom-example:geo_browser_test",
        "//extras/dom-example:idle_browser_test",
        "//extras/dom-example:location_browser_test",
        "//extras/dom-example:media_browser_test",
        "//extras/dom-example:network_browser_test",
        "//extras/dom-example:size_browser_test",
        "//extras/dom-example:visibility_browser_test",
        "//extras/promise-example:browser_test",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":jvm_tests",
        "//core",
        "//doc-examples",
        "//extras/dom",
        "//extras/promise",
        "//extras/spytools",
        "//extras/testng",
        "//persist/core",
        "//persist/processor",
        "//processor",
        "//tools/release:jar_builder",
        "//tools/release:javadoc_jar_builder",
        "//extras/promise-example:java",
        "//extras/dom-example:java",
        "//tools/site:tool",
        "//tools/site/src/test/java/arez/site:all_tests",
    ],
)

java_import(
    name = "core",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    deps = [
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
        "//third_party/java:org_jetbrains_annotations",
    ],
)

java_import(
    name = "processor",
    jars = ["//tools/release:processor_jar"],
    srcjar = "//tools/release:processor_sources",
    deps = [],
)

