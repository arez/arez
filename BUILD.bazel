java_plugin(
    name = "arez_processor_plugin",
    generates_api = True,
    processor_class = "arez.processor.ArezProcessor",
    deps = [":processor"],
)

java_plugin(
    name = "arez_persist_processor_plugin",
    generates_api = True,
    processor_class = "arez.persist.processor.ArezPersistProcessor",
    deps = [":persist_processor"],
)

# These source archives are produced only after the owned Java and generated
# sources pass Error Prone and JSpecify-mode NullAway.
j2cl_library(
    name = "core-j2cl",
    srcs = ["//tools/release:core_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = [
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:grim_annotations-j2cl",
