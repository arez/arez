load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

exports_files(["LICENSE"])

test_suite(
    name = "jvm_tests",
    tests = [
        "//core:tests",
        "//extras/dom:tests",
        "//extras/spytools:tests",
        "//integration-tests:tests",
        "//persist/core:tests",
        "//persist/integration-tests:tests",
        "//persist/processor:all_tests",
        "//processor:all_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":jvm_tests",
        "//core",
        "//doc-examples",
        "//extras/dom",
        "//extras/promise",
        "//extras/spytools",
        "//extras/testng",
        "//persist/core",
        "//persist/processor",
        "//processor",
        "//tools/release:jar_builder",
    ],
)
