load(":release.bzl", "release_jar", "release_javadoc_jar", "release_pom", "release_source_jar", "release_version")

package(default_visibility = ["//visibility:public"])

release_version(
    name = "version",
    build_setting_default = "0.0.0-SNAPSHOT",
)

alias(
    name = "jar_builder",
    actual = "//tools/release/src/main/java/arez/release:jar_builder",
)

release_jar(
    name = "core_jar",
    out = "arez-core.jar",
    java_targets = ["//core/src/main/java/arez"],
    resource_entries = ["META-INF/LICENSE"],
    resource_files = ["//:LICENSE"],
)

release_source_jar(
    name = "core_sources",
    out = "arez-core-sources.jar",
    java_targets = ["//core/src/main/java/arez"],
    resource_entries = [
        "META-INF/LICENSE",
        "arez/ArezConfig.native.js",
        "arez/arez.js",
    ],
    resource_files = [
        "//:LICENSE",
        "//core/src/main/java/arez:ArezConfig.native.js",
        "//core/src/main/java/arez:arez.js",
    ],
)

release_jar(
    name = "processor_jar",
    out = "arez-processor.jar",
    exclude_prefixes = [
        "META-INF/maven/com.fasterxml.jackson",
        "META-INF/maven/com.google.code.findbugs/jsr305/",
        "META-INF/maven/com.google.errorprone/error_prone_annotations/",
        "META-INF/maven/com.google.j2objc/j2objc-annotations/",
        "META-INF/versions/",
        "javax/annotation/",
        "arez/processor/vendor/proton/vendor/google/errorprone/",
        "arez/processor/vendor/proton/vendor/google/j2objc/",
        "arez/processor/vendor/proton/vendor/jackson/",
        "arez/processor/vendor/proton/vendor/jspecify/",
        "META-INF/services/arez.processor.vendor.proton.vendor.jackson.",
    ],
    jars = [
        "@javapoet//file",
        "@proton//:core",
    ],
    java_targets = ["//processor/src/main/java/arez/processor"],
    relocations = [
        "com.palantir.javapoet=arez.processor.vendor.javapoet",
        "org.realityforge.proton=arez.processor.vendor.proton",
    ],
    resource_entries = ["META-INF/LICENSE"],
    resource_files = ["//:LICENSE"],
)

release_source_jar(
    name = "processor_sources",
    out = "arez-processor-sources.jar",
    java_targets = ["//processor/src/main/java/arez/processor"],
    resource_entries = [
        "META-INF/LICENSE",
        "META-INF/services/javax.annotation.processing.Processor",
    ],
    resource_files = [
        "//:LICENSE",
        "//processor/src/main/resources/META-INF/services:javax.annotation.processing.Processor",
    ],
)

