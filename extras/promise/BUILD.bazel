load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("@rules_java//java:defs.bzl", "java_import")
load("//third_party/java:rules.bzl", "java_library")
load("//tools/browser:rules.bzl", "browser_compile_smoke")

package(default_visibility = ["//visibility:private"])

java_library(
    name = "promise",
    srcs = ["//extras/promise/src/main/java/arez/promise:all"],
    plugins = ["//processor:plugin"],
    visibility = [
        "//:__pkg__",
        "//tools/release:__pkg__",
    ],
    deps = [
        "//core",
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
    ],
)

closure_js_library(
    name = "compile_smoke_entry",
    srcs = ["src/test/js/arez/promise/PromiseCompileTest.js"],
    deps = ["//:promise-j2cl"],
)

browser_compile_smoke(
    name = "compile_smoke",
    entry_point = "arez.promise.PromiseCompileTest",
    deps = [":compile_smoke_entry"],
)

java_import(
    name = "packaged",
    jars = ["//tools/release:promise_jar"],
    srcjar = "//tools/release:promise_sources",
    visibility = ["//:__pkg__"],
    deps = [
        "//:core",
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
    ],
)

j2cl_library(
    name = "packaged_j2cl",
    srcs = ["//tools/release:promise_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//:core-j2cl",
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:grim_annotations-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
    ],
)
