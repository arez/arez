load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("//third_party/java:rules.bzl", "java_library")
load("//tools/browser:rules.bzl", "browser_compile_smoke")

package(default_visibility = ["//visibility:private"])

java_library(
    name = "promise",
    srcs = ["//extras/promise/src/main/java/arez/promise:all"],
    plugins = ["//processor:plugin"],
    visibility = [
        "//:__pkg__",
        "//tools/release:__pkg__",
    ],
    deps = [
        "//core",
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
    ],
)

closure_js_library(
    name = "compile_smoke_entry",
    srcs = ["src/test/js/arez/promise/PromiseCompileTest.js"],
    deps = ["//:promise-j2cl"],
)

browser_compile_smoke(
    name = "compile_smoke",
    entry_point = "arez.promise.PromiseCompileTest",
    deps = [":compile_smoke_entry"],
)
