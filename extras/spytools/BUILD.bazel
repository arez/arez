load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_closure//closure:defs.bzl", "closure_js_library")
load("@rules_java//java:defs.bzl", "java_import")
load("//third_party/java:rules.bzl", "java_library", "java_testng")
load("//tools/browser:rules.bzl", "browser_compile_smoke")

package(default_visibility = ["//visibility:private"])

closure_js_library(
    name = "compile_smoke_entry",
    srcs = ["src/test/js/arez/spytools/SpyToolsCompileTest.js"],
    deps = ["//:spytools-j2cl"],
)

browser_compile_smoke(
    name = "compile_smoke",
    entry_point = "arez.spytools.SpyToolsCompileTest",
    deps = [":compile_smoke_entry"],
)

java_library(
    name = "spytools",
    srcs = ["//extras/spytools/src/main/java/arez/spytools:all"],
    plugins = ["//processor:plugin"],
    visibility = [
        "//:__pkg__",
        "//tools/release:__pkg__",
    ],
    deps = [
        "//core",
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
        "//third_party/java:org_jetbrains_annotations",
    ],
)

java_testng(
    name = "tests",
    srcs = ["//extras/spytools/src/test/java/arez/spytools:all"],
    jvm_flags = [
        "-Darez.environment=development",
        "-Dbraincheck.environment=development",
    ],
    test_classes = [
        "arez.spytools.SpyEventProcessorTest",
        "arez.spytools.SpyUtilTest",
        "arez.spytools.WhyRunTest",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        ":spytools",
        "//core",
        "//third_party/java:braincheck_core",
        "//third_party/java:guiceyloops",
        "//third_party/java:jspecify",
    ],
)

java_import(
    name = "packaged",
    jars = ["//tools/release:spytools_jar"],
    srcjar = "//tools/release:spytools_sources",
    visibility = ["//:__pkg__"],
    deps = [
        "//:core",
        "//third_party/java:base",
        "//third_party/java:braincheck_core",
        "//third_party/java:grim_annotations",
        "//third_party/java:jsinterop_annotations",
        "//third_party/java:jspecify",
        "//third_party/java:org_jetbrains_annotations",
    ],
)

j2cl_library(
    name = "packaged_j2cl",
    srcs = ["//tools/release:spytools_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//:__pkg__"],
    deps = [
        "//:core-j2cl",
        "//third_party/java:braincheck_core-j2cl",
        "//third_party/java:grim_annotations-j2cl",
        "//third_party/java:jsinterop_annotations-j2cl",
        "//third_party/java:jsinterop_base-j2cl",
        "//third_party/java:jspecify-j2cl",
        "//third_party/java:org_jetbrains_annotations-j2cl",
    ],
)
